# ─── Google Gemini AI ───────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Retry policy for transient Gemini API failures (429 / 5xx)
GEMINI_MAX_RETRIES=4
GEMINI_BASE_DELAY_MS=500
GEMINI_MAX_DELAY_MS=30000

# Hard wall-clock timeout for each Gemini API call (seconds)
GEMINI_TIMEOUT_SECS=120

# ─── Security & Authentication ───────────────────────────────────────────────
# Change this to a strong random value in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=dev-secret-key-12345
API_KEY_HEADER=X-API-Key

# ─── File Upload ─────────────────────────────────────────────────────────────
# Maximum allowed size per uploaded PDF file (megabytes)
MAX_UPLOAD_SIZE_MB=15

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./course_esum.db

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
RATE_LIMIT_PER_MINUTE=60/minute
DEFAULT_MAX_REPORTS=3
